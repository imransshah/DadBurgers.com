{
  "name": "career-kb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Career KB — searchable desk cards, slideshows and the Mandates section (executive orders and implementing guidance) for a federal IT Director / Deputy CIO.",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "npm run content && vite",
    "build": "npm run content && vite build",
    "preview": "vite preview",
    "worker:dev": "npm run build && wrangler dev",
    "validate": "node scripts/build-content.mjs --check && node mandates/scripts/validate-data.mjs",
    "mandates:sync": "node mandates/scripts/sync-federal-register.mjs",
    "mandates:watch": "node mandates/scripts/watch-guidance.mjs",
    "mandates:triage": "node mandates/scripts/triage.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "js-yaml": "^5.5.0",
    "marked": "^18.2.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "wrangler": "^4.160.1"
  }
}
