# Copy to .env.local for local development.
#
# The public URL of the chat worker (see /worker). This value ships in the
# browser bundle — that is fine, it is just a URL. The Anthropic API key is
# NOT set here; it lives as a server-side secret on the worker.
#
# Leave it as the placeholder and the chat UI shows a friendly
# "not switched on yet" state instead of erroring.
VITE_CHAT_API_URL=https://your-worker-name.workers.dev/chat
